# Generated builds and deliverables
DDS_Nuget/generated/
DDSCPP/generated/
artifacts/
DDSClient-Developer-Package/
BUILD-DOCTOR.json

# Local validation and harness directories
.tmp-*/
.validation-*/

# Build caches
**/build/
**/build-*/
**/bin/
**/obj/
**/.vs/
**/__pycache__/
*.pyc

# Build orchestration is source, not a generated build directory.
!tools/build/
!tools/build/**

# Re-inclusion above must not expose generated fixture caches.
tools/build/**/bin/
tools/build/**/obj/
tools/build/**/__pycache__/

# Large offline binaries are published as GitHub Release assets
offline-tools/windows-x64/installers/
offline-tools/linux-x64/*.tar

# Runtime lock files
*.lock
