ARG DOTNET_IMAGE=mcr.microsoft.com/dotnet/sdk:9.0
ARG ROCKY_IMAGE=ddsclient-rocky9-builder:latest
FROM ${DOTNET_IMAGE} AS dotnet
FROM ${ROCKY_IMAGE}
COPY --from=dotnet /usr/share/dotnet /usr/share/dotnet
ENV PATH="/usr/share/dotnet:${PATH}" \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1
ENTRYPOINT ["bash", "/workspace/tools/docker/test-linux.sh"]
